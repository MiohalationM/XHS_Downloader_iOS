    "archive.error.write": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write to the folder: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入文件夹：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入資料夾：%@"
          }
        }
      }
    },
    "archive.error.write.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be written to the archive folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入归档目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
