          }
        }
      }
    },
    "backup.error.finalize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the final library state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存最终的笔记库状态。"
          }
