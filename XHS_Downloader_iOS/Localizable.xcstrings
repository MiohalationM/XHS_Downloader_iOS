        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting history keeps saved photos and videos. Deleting saved items too also removes them from the system Photos library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除历史会保留已保存的照片和视频。选择同时删除，会将它们从系统照片中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除記錄會保留已儲存的照片和影片。選擇同時刪除，會將它們從系統照片中移除。"
          }
        }
      }
