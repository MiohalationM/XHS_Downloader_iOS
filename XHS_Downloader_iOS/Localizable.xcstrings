          "stringUnit": {
            "state": "translated",
            "value": "無法儲存最終的筆記庫狀態。"
          }
        }
      }
    },
    "backup.error.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld originals could not be read and are missing from the archive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个原件无法读取，归档中缺少这些文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個原件無法讀取，封存中缺少這些檔案。"
          }
        }
      }
    },
    "backup.error.partial_import": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some data was saved, but the restore did not finish. Preferences have not been applied. Import the backup again to retry. Reason: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分数据已保存，但恢复尚未全部完成，偏好设置未应用。可重新导入此备份继续恢复。原因：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資料已儲存，但還原尚未全部完成，偏好設定未套用。可重新匯入此備份繼續還原。原因：%@"
          }
        }
      }
    },
    "backup.error.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
